# Public smoke-test inputs. Copy this file to .env and adjust as needed.
# StudioNet is 61999; Bradbury is 4221. The script refuses a mismatch.
GROUNDING_EXPECTED_CHAIN_ID=61999
GROUNDING_EXPECTED_NETWORK_NAME=Genlayer Studio Network
GROUNDING_EXPECTED_RPC_URL=https://studio.genlayer.com/api
GROUNDING_ALLOWED_DOMAINS_JSON=["example.com"]
GROUNDING_SMOKE_SOURCE_URLS_JSON=["https://example.com/"]
GROUNDING_SMOKE_CLAIM=This domain is for use in illustrative examples in documents.
GROUNDING_SMOKE_EXPECTED_VERDICT=SUPPORTED
GROUNDING_WAIT_STATUS=ACCEPTED
GROUNDING_WAIT_RETRIES=200
GROUNDING_WAIT_INTERVAL_MS=5000
GROUNDING_DEPLOYMENT_OUTPUT=artifacts/deployment.json

# Bradbury gltest runs require a funded, testnet-only key. Never commit it.
# ACCOUNT_PRIVATE_KEY_1=0x...
